{
  "name": "OTL home: signed-in dashboard",
  "url": "http://localhost:5173/",
  "session": "otl",
  "steps": [
    { "wait": 3000 },
    { "read": "page", "expect": "Available" },
    { "focus": "role=textbox[name=\"Select date\"]", "expect": "Select date" },
