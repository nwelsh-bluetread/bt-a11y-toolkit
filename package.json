{
  "name": "@bluetread/accessibility-toolkit",
  "version": "0.5.0",
  "description": "BlueTread's internal, repeatable accessibility testing toolkit. Reusable automated a11y checks, WCAG-mapped scoring, report generation, and Jira ticket creation for web and React Native applications.",
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "react-native",
    "testing",
    "audit"
  ],
  "author": "BlueTread",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "bt-a11y": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "default": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./matchers": {
      "import": {
        "types": "./dist/matchers/index.d.ts",
        "default": "./dist/matchers/index.js"
      },
      "require": {
        "types": "./dist/cjs/matchers/index.d.ts",
        "default": "./dist/cjs/matchers/index.js"
      },
      "default": {
        "types": "./dist/cjs/matchers/index.d.ts",
        "default": "./dist/cjs/matchers/index.js"
      }
    },
    "./react-native": {
      "import": {
        "types": "./dist/react-native/index.d.ts",
        "default": "./dist/react-native/index.js"
      },
      "require": {
        "types": "./dist/cjs/react-native/index.d.ts",
        "default": "./dist/cjs/react-native/index.js"
      },
      "default": {
        "types": "./dist/cjs/react-native/index.d.ts",
        "default": "./dist/cjs/react-native/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.build.json",
    "build:cjs": "tsc -p tsconfig.build.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({ type: 'commonjs' }, null, 2) + '\\n')\"",
    "dev": "tsc -p tsconfig.build.json --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:lighthouse": "vitest run tests/lighthouse.test.ts",
    "scan:lighthouse": "tsx scripts/lighthouse.ts",
    "test:axe": "vitest run tests/axe.test.ts",
    "scan:axe": "tsx scripts/axe.ts",
    "scan:urls": "tsx scripts/urls.ts",
    "scan:all": "tsx scripts/scan.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@axe-core/puppeteer": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.7.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@vitest/coverage-v8": "^2.1.2",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9.12.0",
    "lighthouse": "^13.4.1",
    "puppeteer": "^25.11.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^2.1.2"
  }
}
